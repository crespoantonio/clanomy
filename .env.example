# Database Configuration (Docker Compose)
# (Optional) Default fallback values are provided in docker-compose.yml
POSTGRES_USER=famfin_user
POSTGRES_PASSWORD=famfin_password
POSTGRES_DB=famfin_db

# Security & API Keys
# (Required) Must be a valid 32-byte url-safe base64-encoded Fernet key.
# Generate a key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_encryption_key_here

# (Required) Your Telegram Bot API token from BotFather.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# App Configuration
# (Optional) Fallback: sqlite:///./famfin.db
DATABASE_URL=postgresql+psycopg://famfin_user:famfin_password@db:5432/famfin_db

# (Required) Token for webhooks (if you use messaging webhooks).
MESSAGING_WEBHOOK_SECRET=your_messaging_secret_token_here

# Whisper Settings
# (Optional) Fallback: base
WHISPER_MODEL_SIZE=base
# (Optional) Fallback: cpu
WHISPER_DEVICE=cpu
# (Optional) Fallback: int8
WHISPER_COMPUTE_TYPE=int8
# (Optional) Fallback: 5
WHISPER_BEAM_SIZE=5
# (Optional) Fallback: 0.0
WHISPER_TEMPERATURE=0.0
# (Optional) Fallback: False
WHISPER_VAD_FILTER=False
# (Optional) Fallback: 1
WHISPER_MAX_CONCURRENT=1

# Ollama Settings
# (Optional) Fallback: http://localhost:11434
# Base URL for the Ollama instance (e.g. http://ollama:11434 for docker)
OLLAMA_BASE_URL=http://ollama:11434
# (Optional) Fallback: llama3
# Model to use for extraction (e.g. llama3, mistral)
OLLAMA_MODEL=llama3
# (Optional) Fallback: 3
OLLAMA_MAX_RETRIES=3
# (Optional) Fallback: 0.5
OLLAMA_RETRY_BACKOFF_MIN=0.5
# (Optional) Fallback: 4.0
OLLAMA_RETRY_BACKOFF_MAX=4.0

# HTTP Client Pool Settings
# (Optional) Fallback: 50
HTTP_POOL_MAX_CONNECTIONS=50
# (Optional) Fallback: 20
HTTP_POOL_MAX_KEEPALIVE=20
# (Optional) Fallback: 30.0
HTTP_TIMEOUT=30.0

# No callbacks (using native Telegram API via httpx)

# App primary currency
# (Optional) Fallback: USD
DEFAULT_CURRENCY=USD
