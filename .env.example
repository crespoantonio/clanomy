# Database Configuration (Container Compose / PostgreSQL)
# (Optional) Default fallback values are provided in docker-compose.yml
POSTGRES_USER=clanomy_user
POSTGRES_PASSWORD=clanomy_password
POSTGRES_DB=clanomy_db

# Security & API Keys
# (Required) Must be a valid 32-byte url-safe base64-encoded Fernet key.
# Generate a key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_encryption_key_here

# (Required) Your Telegram Bot API token from BotFather.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# App Configuration
# (Optional) Fallback: sqlite:///./clanomy.db
DATABASE_URL=postgresql+psycopg://clanomy_user:clanomy_password@db:5432/clanomy_db

# (Required) Token for webhooks (if you use messaging webhooks).
MESSAGING_WEBHOOK_SECRET=your_messaging_secret_token_here

# (Optional) Token for the read-only message simulation & evaluation endpoint (/api/v1/simulate/message).
# Leave empty to keep the simulation endpoint disabled.
SIMULATION_SECRET=

# (Optional) Origin Shielding Token (blocks direct traffic to server bypassing Cloudflare)
# Configure Cloudflare Transform Rule to attach header: X-Origin-Verify-Secret
CLOUDFLARE_ORIGIN_SECRET=

# (Optional) API Documentation Stealth Mode
# Set to 'false' (default) in production to hide /docs, /redoc, /openapi.json from scanners.
ENABLE_DOCS=false

# Access Control / Allowlist (Self-Hosting Hardening)
# Comma-separated list of Telegram usernames (e.g. tony, john_doe) or numeric Telegram IDs (e.g. 123456789)
# Leave empty to allow any user to interact with the bot.
ALLOWED_TELEGRAM_USERS=

# Ingress & Pre-Inference Guardrails
# Maximum duration in seconds for voice notes (rejects longer recordings before downloading or Whisper inference)
MAX_VOICE_DURATION_SECONDS=60
# Maximum character length for incoming text messages (rejects oversized text before Ollama inference)
MAX_TEXT_LENGTH=350

# AI Engine Configuration (Unified Provider / Multi-Backend Support)
# AI_PROVIDER can be:
#   - "gemini" (recommended): Uses Google Gemini 2.0 Flash with native multimodal audio transcription.
#   - "groq": Uses Groq Llama-3.3-70b and Groq Cloud Whisper.
#   - "openai": Uses OpenAI gpt-4o-mini and whisper-1.
#   - "ollama": Self-hosted local Ollama and faster-whisper.
# Reuses existing AI_API_KEY (or GEMINI_API_KEY, GROQ_API_KEY, OPENAI_API_KEY).
AI_PROVIDER=gemini
AI_API_KEY=
# Optional manual overrides (automatically resolved if omitted):
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.0-flash
# AI_WHISPER_MODEL=gemini-2.0-flash
AI_MAX_RETRIES=3
AI_RETRY_BACKOFF_MIN=0.5
AI_RETRY_BACKOFF_MAX=4.0


# Local Ollama Fallback Settings (when AI_API_KEY is not set)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Local Faster-Whisper Fallback Settings (when AI_API_KEY is not set)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_TEMPERATURE=0.0
WHISPER_VAD_FILTER=False
WHISPER_MAX_CONCURRENT=1

# HTTP Client Pool Settings
# (Optional) Fallback: 50
HTTP_POOL_MAX_CONNECTIONS=50
# (Optional) Fallback: 20
HTTP_POOL_MAX_KEEPALIVE=20
# (Optional) Fallback: 30.0
HTTP_TIMEOUT=30.0

# No callbacks (using native Telegram API via httpx)

# App primary currency
# (Optional) Fallback: USD
DEFAULT_CURRENCY=USD
